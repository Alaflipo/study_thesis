          "restartEnumeration": true
        },
        {
          "id": "q-slider1",
          "prompt": "How often do you use metro maps or other types of schematic transit maps?",
          "infoText": "Use the slider to indicate your rating on a scale from 'Never' to 'Very often'.",
          "type": "slider",
          "startingValue": 2,
          "step": 1,
          "spacing": 1, 
          "snap": true, 
          "withDivider": true, 
          "options": [
            {
              "label": "Never",
              "value": 0
            },
            {
              "label": "Rarely",
              "value": 1
            },
            {
              "label": "Sometimes",
              "value": 2
            },
            {
              "label": "Often",
              "value": 3
            },
            {
              "label": "Very often",
              "value": 4
            }
          ]
        }, 
        {
          "id": "q-slider2",
          "prompt": "How familiar are you with the design of metro maps or other schematic transit maps?",
          "infoText": "Use the slider to indicate your rating on a scale from 'Not familiar' to 'Very familiar'.",
          "type": "slider",
          "startingValue": 2,
          "step": 1,
          "spacing": 1, 
          "snap": true, 
          "withDivider": true, 
          "options": [
            {
              "label": "Not familiar",
              "value": 0
            },
            {
              "label": "Slightly familiar",
              "value": 1
            },
            {
              "label": "Somewhat familiar",
              "value": 2
            },
            {
              "label": "Quite familiar",
              "value": 3
            },
            {
              "label": "Very familiar",
              "value": 4
            }
          ]
        }, 
        {
          "id": "q-slider3",
          "prompt": "How familiar are you with graphic design software? (e.g. Photoshop, Illustrator, Figma, Canva, Blender, Powerpoint (for graphics)",
          "infoText": "Use the slider to indicate your rating on a scale from 'Not familiar' to 'Very familiar'.",
          "type": "slider",
          "startingValue": 2,
          "step": 1,
          "spacing": 1, 
          "snap": true, 
          "withDivider": true, 
          "options": [
            {
              "label": "Not familiar",
              "value": 0
            },
            {
              "label": "Slightly familiar",
              "value": 1
            },
            {
              "label": "Somewhat familiar",
              "value": 2
            },
            {
              "label": "Quite familiar",
              "value": 3
            },
            {
              "label": "Very familiar",
              "value": 4
            }
          ]
        }, 
        {
          "id": "q-slider4",
          "prompt": "How comfortable are you navigating graphic design software interfaces?",
          "infoText": "Use the slider to indicate your rating on a scale from 'Not familiar' to 'Very familiar'.",
          "type": "slider",
          "startingValue": 2,
          "step": 1,
          "spacing": 1, 
          "snap": true, 
          "withDivider": true, 
          "options": [
            {
              "label": "Not comfortable",
              "value": 0
            },
            {
              "label": "Slightly comfortable",
              "value": 1
            },
            {
              "label": "Somewhat comfortable",
              "value": 2
            },
            {
              "label": "Quite comfortable",
              "value": 3
            },
            {
              "label": "Very comfortable",
              "value": 4
            }
          ]
        }, 
        {
          "id": "q-checkbox",
          "prompt": "Check the box if you have seen an image of the metro map of this city before. If you don't recognize any you can leave all boxes unchecked.",
          "infoText": "Select the cities from the available options.",
          "minSelections": 0,
          "maxSelections": 6,
          "type": "checkbox",
          "options": [
            "Wien",
            "Wuerzburg",
            "Sydney", 
            "Stuttgart", 
            "Freiburg", 
            "Milan"
          ],
          "withDivider": true,
          "required": false
        }
      ]
